# Copy to .env and fill in. Never commit .env.
# Generate each password with: openssl rand -base64 32 | tr -d '/+=\n'

POSTGRES_PASSWORD=
SYNQSONG_OWNER_PASSWORD=
SYNQSONG_APP_PASSWORD=

# Keep the data directory outside the repo and outside backups of the secrets.
PG_DATA_DIR=./.data/postgres
POSTGRES_PORT=5433
